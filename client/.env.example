# --- Frontend (client/) environment variables ---
# Copy to `.env` locally. In production set these in Vercel.

# Server-only. Read inside TanStack server functions (src/lib/chordapi.server.ts).
# Base URL of the FastAPI backend deployed on Railway.
# Leave unset to use the built-in sample catalog.
# Local:      http://localhost:8000
# Production: https://<your-app>.up.railway.app
CHORD_API_URL=

# Client-visible. Exposed to the browser (must keep the VITE_ prefix).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# NEVER put SUPABASE_SERVICE_ROLE_KEY here or prefix it with VITE_.
# Service-role keys belong only in Railway/Vercel server-side env vars.
